# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: URL of SQLite database (default is local database.db)
DATABASE_URL="sqlite:///database.db"

# SECRET_KEY: Secret string used for cookie sessions
SECRET_KEY="super-secret-kanban-key-1234"

# BACKUP_ENABLED: Whether to back up database automatically
BACKUP_ENABLED="true"

# BACKUP_DIR: Folder path to write SQLite .db clones
BACKUP_DIR="backups"

# BACKUP_PERIOD: Period of automatic backup triggers ('daily', 'weekly', 'monthly')
BACKUP_PERIOD="daily"

# EXPORT_DIR: Folder path for excel worksheets exports
EXPORT_DIR="exports"

